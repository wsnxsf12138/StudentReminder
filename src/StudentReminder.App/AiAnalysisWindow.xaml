<Window x:Class="StudentReminder.App.AiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 分析 · 学生事务助理" Width="960" Height="710" MinWidth="760" MinHeight="620"
        FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F3F6FA" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="AI 分析" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/>
    <TabControl x:Name="AnalysisTabs" Grid.Row="1" IsEnabled="False">
      <TabItem Header="模型设置" AutomationProperties.AutomationId="AiModelSettings">
        <Grid Margin="14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="10"
                  Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                  <Button Content="测试连接" Click="Test_Click" Padding="12,6" AutomationProperties.AutomationId="TestAiConnection"/>
                  <Button Content="保存配置" Click="Save_Click" Padding="12,6" Margin="0" AutomationProperties.AutomationId="SaveAiProfile"/>
                </WrapPanel>
                <TextBlock Text="服务商配置" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="服务商" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="ProviderBox" Width="148" HorizontalAlignment="Left" Padding="8,4"
                          SelectionChanged="Provider_Changed" AutomationProperties.Name="分析服务">
                  <ComboBoxItem Content="DeepSeek" Tag="deepseek"/><ComboBoxItem Content="豆包" Tag="doubao"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Text="API 地址" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ApiAddress" Margin="0,8,0,0" Foreground="#475569"/>
                <TextBlock Grid.Row="2" Text="API Key" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" LastChildFill="False">
                  <PasswordBox x:Name="KeyBox" Width="240" MaxLength="2048" Padding="8,4" AutomationProperties.Name="API Key"/>
                  <TextBlock Text="留空沿用已保存密钥" Margin="10,0,0,0" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
              </Grid>
              <TextBlock Text="连接测试只发送合成文本。分析时会向所选服务商发送脱敏正文、发送时间和时区。"
                         TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="#475569"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="10" Padding="16,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="获取模型列表" Click="FetchModels_Click" Margin="0" Padding="12,6"
                        ToolTip="使用当前服务商的 API Key 查询模型列表"
                        AutomationProperties.AutomationId="FetchAiModels"/>
                <TextBlock Text="模型" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Grid.Row="1" Margin="0,0,0,9">
                <TextBlock DockPanel.Dock="Left" Text="当前模型 ID" Width="84" VerticalAlignment="Center"/>
                <ComboBox DockPanel.Dock="Left" x:Name="ModelBox" Width="282" IsEditable="True" IsTextSearchEnabled="False"
                          MaxDropDownHeight="280" VerticalContentAlignment="Center" Padding="8,4"
                          TextBoxBase.TextChanged="ModelText_Changed"
                          AutomationProperties.Name="模型 ID"/>
                <TextBlock x:Name="ProviderHint" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="12" Foreground="#475569"/>
              </DockPanel>
              <DockPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" x:Name="ModelListCaption" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="12" Foreground="#475569"/>
                <Label DockPanel.Dock="Left" Content="搜索模型 ID" Target="{Binding ElementName=ModelSearchBox}" Padding="0"
                       Width="84" VerticalAlignment="Center" Foreground="#25364A"/>
                <TextBox x:Name="ModelSearchBox" Padding="8,4" MaxLength="128" TextChanged="ModelSearch_Changed"
                         AutomationProperties.Name="搜索模型 ID"/>
              </DockPanel>
              <ListBox Grid.Row="3" x:Name="ModelList" BorderBrush="#DEE6ED" SelectionChanged="ModelList_Changed"
                       AutomationProperties.Name="可选模型">
                <ListBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" Margin="6,3"/></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="本地初筛">
        <Border Margin="14" Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="10" Padding="16">
          <StackPanel>
            <CheckBox x:Name="HybridEnabled" Content="自动分析时启用本地初筛" Margin="0,0,0,10"
                      AutomationProperties.AutomationId="EnableLocalTriage"/>
            <TextBlock Text="在本机用 Qwen3.5 GGUF 筛选通知、寻找同一授权会话的关联前文。云端只收到脱敏片段、发送时间、时区和临时发言代号。"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock Text="本地模型文件（Qwen3.5 2B 或 4B GGUF）" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Content="选择文件" Click="BrowseLocalModel_Click" Margin="8,0,0,0"/>
              <TextBox x:Name="LocalModelPath" AutomationProperties.Name="本地模型文件"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,12">
              <TextBlock Text="每批条数" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="BatchCountBox" Width="56" MaxLength="1" Text="4"
                       AutomationProperties.Name="每批主消息条数"/>
              <TextBlock Text="最长等待（秒）" VerticalAlignment="Center" Margin="16,0,8,0"/>
              <TextBox x:Name="BatchWaitBox" Width="78" MaxLength="3" Text="120"
                       AutomationProperties.Name="批次最长等待秒数"/>
            </WrapPanel>
            <TextBlock Text="按会话分别排队，满足条数或等待时间就提交。暂停和退出后，未提交的消息留在历史消息里。"
                       TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12" Foreground="#475569"/>
            <WrapPanel>
              <Button Content="测试本地模型" Click="TestLocalModel_Click" AutomationProperties.AutomationId="TestLocalTriage"/>
              <Button Content="保存本地设置" Click="SaveHybrid_Click" AutomationProperties.AutomationId="SaveLocalTriage"/>
            </WrapPanel>
            <TextBlock Text="推理由程序自带的 CPU 运行时完成。测试只用固定的合成消息。"
                       TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Foreground="#475569"/>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="本地直读自动分析">
        <DockPanel Margin="14">
          <TextBlock DockPanel.Dock="Top" Text="从已授权采集的会话中勾选分析范围。开启后只发送新收到且在开启后发出的相关文本，旧消息可到「历史消息」补分析。" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="刷新会话" Click="Scopes_Click" Padding="10,5"/>
            <Button Content="开启自动分析" Click="Automatic_Click" Padding="10,5" AutomationProperties.AutomationId="StartAutomaticAnalysis"/>
          </StackPanel>
          <ListBox x:Name="AutomaticScopes" AutomationProperties.Name="自动分析会话">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="4"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="历史消息">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="96"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,9">
            <ComboBox x:Name="HistoryScope" Width="258" SelectionChanged="History_Changed" AutomationProperties.Name="历史会话"/>
            <TextBlock Text="从" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <DatePicker x:Name="FromDate" SelectedDateChanged="History_Changed" AutomationProperties.Name="开始日期"/>
            <TextBlock Text="至" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <DatePicker x:Name="ToDate" SelectedDateChanged="History_Changed" AutomationProperties.Name="结束日期"/>
            <Button Content="预览" Click="Preview_Click" Margin="10,0,0,0" Padding="9,5" AutomationProperties.AutomationId="PreviewAnalysis"/>
          </WrapPanel>
          <TextBlock Grid.Row="1" Text="每页 200 条。可逐条预览，也可选择同一会话的 2～4 条消息联合分析。已分析的消息可作为上下文。"
                     TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12" Foreground="#475569"/>
          <DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                    SelectionChanged="Preview_SelectionChanged" AutomationProperties.AutomationId="AnalysisPreviewList">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="发送" Width="55">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center" AutomationProperties.Name="选中此消息"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="发送时间" Binding="{Binding Time}" Width="150" IsReadOnly="True"/>
              <DataGridTextColumn Header="脱敏正文" Binding="{Binding Snippet}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="分析状态" Binding="{Binding Status}" Width="220" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBox x:Name="PreviewText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Margin="0,8,0,0" AutomationProperties.AutomationId="AnalysisOutboundText"/>
          <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <Button Content="逐条分析" Click="Manual_Click" Padding="10,5"/>
              <Button Content="联合分析" Click="Combined_Click" Padding="10,5" AutomationProperties.AutomationId="CombinedAnalysis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button x:Name="PreviousPage" Content="上一页" Click="Previous_Click" IsEnabled="False" Padding="10,5"/>
              <Button x:Name="NextPage" Content="下一页" Click="Next_Click" IsEnabled="False" Padding="10,5" Margin="0"/>
            </StackPanel>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button x:Name="PauseButton" DockPanel.Dock="Right" Content="暂停分析" Click="Pause_Click" Padding="10,5"
              IsEnabled="False" VerticalAlignment="Center" AutomationProperties.AutomationId="PauseAnalysis"/>
      <StackPanel Margin="0,0,10,0">
        <TextBlock x:Name="RunStatus" Text="分析已暂停。" TextWrapping="Wrap" Foreground="#0F766E" AutomationProperties.AutomationId="AiRunStatus"/>
        <TextBlock x:Name="UsageLabel" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="#475569"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
