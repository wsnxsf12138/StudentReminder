<Window x:Class="StudentReminder.App.EventReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="事项 · 学生事务助理" Width="1120" Height="820" MinWidth="860" MinHeight="650"
        FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F3F6FA" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button Content="刷新" DockPanel.Dock="Right" Click="Refresh_Click" Margin="12,0,0,0" Padding="10,5"/>
      <ComboBox x:Name="ViewBox" DockPanel.Dock="Right" Width="135" SelectedIndex="0" SelectionChanged="View_Changed" AutomationProperties.Name="事项视图">
        <ComboBoxItem Content="待确认"/><ComboBoxItem Content="审核记录"/><ComboBoxItem Content="已确认事项"/>
      </ComboBox>
      <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Right" Width="100" Margin="0,0,8,0"
                SelectionChanged="View_Changed" AutomationProperties.Name="按类别筛选"/>
      <DatePicker x:Name="DateFilter" DockPanel.Dock="Right" Width="136" Margin="0,0,8,0"
                  SelectedDateChanged="DateFilter_Changed" AutomationProperties.Name="按日期筛选"/>
      <TextBlock Text="事项" FontSize="25" FontWeight="Bold"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="ReviewGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                SelectionMode="Single" SelectionChanged="Row_Changed" AutomationProperties.AutomationId="ReviewItems">
        <DataGrid.Columns>
          <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
          <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="64"/>
          <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="75"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="2" Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DetailPanel" Margin="16" IsEnabled="False">
            <TextBlock x:Name="SummaryLabel" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="AmbiguityLabel" Foreground="#8A4B12" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="标题" VerticalAlignment="Center"/>
              <TextBox x:Name="TitleBox" Grid.Column="1" MaxLength="120" Margin="0,0,0,5" AutomationProperties.Name="标题"/>
              <TextBlock Grid.Row="1" Text="类别" VerticalAlignment="Center"/>
              <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" AutomationProperties.Name="类别"/>
              <TextBlock Grid.Row="2" Text="动作" VerticalAlignment="Center"/>
              <TextBox x:Name="ActionBox" Grid.Row="2" Grid.Column="1" MaxLength="240" Margin="0,0,0,5" AutomationProperties.Name="动作"/>
              <TextBlock Grid.Row="3" Text="地点" VerticalAlignment="Center"/>
              <TextBox x:Name="LocationBox" Grid.Row="3" Grid.Column="1" MaxLength="160" Margin="0,0,0,5" AutomationProperties.Name="地点"/>
              <TextBlock Grid.Row="4" Text="开始" VerticalAlignment="Center"/>
              <TextBox x:Name="StartBox" Grid.Row="4" Grid.Column="1" MaxLength="32" Margin="0,0,0,5" AutomationProperties.Name="开始时间"/>
              <TextBlock Grid.Row="5" Text="截止" VerticalAlignment="Center"/>
              <TextBox x:Name="DeadlineBox" Grid.Row="5" Grid.Column="1" MaxLength="32" AutomationProperties.Name="截止时间"/>
            </Grid>
            <TextBlock Text="可填 2026-11-13 或 2026-11-13 18:00 +08:00。填入具体时刻后才安排定时提醒。"
                       FontSize="12" Foreground="#475569" Margin="0,6,0,10" TextWrapping="Wrap"/>
            <StackPanel x:Name="LinkPanel" Visibility="Collapsed" Margin="0,0,0,10">
              <TextBlock Text="关联已有事项" FontWeight="Bold" Margin="0,0,0,4"/>
              <ComboBox x:Name="LinkBox" SelectionChanged="Link_Changed" AutomationProperties.Name="关联已有事项"/>
              <TextBlock x:Name="ComparisonLabel" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#475569"/>
            </StackPanel>
            <WrapPanel x:Name="CandidateActions" Visibility="Collapsed" Margin="0,0,0,10">
              <Button x:Name="ConfirmButton" Content="确认事项" Click="Confirm_Click" Padding="10,5" AutomationProperties.AutomationId="ConfirmEvent"/>
              <Button x:Name="IgnoreButton" Content="忽略" Click="Ignore_Click" Padding="10,5"/>
              <Button x:Name="DeleteCandidateButton" Content="删除候选" Click="DeleteCandidate_Click" Padding="10,5"/>
            </WrapPanel>
            <WrapPanel x:Name="EventActions" Visibility="Collapsed" Margin="0,0,0,10">
              <Button x:Name="EditButton" Content="保存修改" Click="Edit_Click" Padding="10,5"/>
              <Button x:Name="CompleteButton" Content="标记完成" Click="Complete_Click" Padding="10,5"/>
              <Button Content="删除事项" Click="DeleteEvent_Click" Padding="10,5"/>
            </WrapPanel>
            <TextBlock x:Name="EvidenceHeading" Text="来源证据" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="ReviewEvidenceBox" Height="135" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ReviewEvidence"/>
            <StackPanel x:Name="VersionPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <TextBlock Text="版本记录" FontWeight="Bold" Margin="0,0,0,5"/>
              <ComboBox x:Name="VersionBox" SelectionChanged="Version_Changed" AutomationProperties.Name="事件版本"/>
              <TextBlock x:Name="VersionDetails" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#475569"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <TextBlock x:Name="ReviewStatus" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#0F766E"/>
  </Grid>
</Window>
