<Window x:Class="StudentReminder.App.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息来源 · 学生事务助理" Width="1180" Height="760" MinWidth="1080" MinHeight="700"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F6FA"
        Loaded="Window_Loaded" Closed="Window_Closed">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="消息来源与同步" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="每次启动默认暂停。保存来源后，读取并勾选会话，再手动开始同步。" Foreground="#64748B" Margin="0,8,0,0"/>
      <TextBlock Text="微信/QQ 直读需要保持对应客户端登录。切换账号前先暂停，并为新账号创建来源别名。" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" x:Name="ConfigurationPanel">
      <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" Padding="16" CornerRadius="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="已配置来源" FontWeight="Bold" FontSize="17" Margin="0,0,0,14"/>
            <Button Content="新建配置" Click="New_Click" Margin="0,0,0,12"/>
          </StackPanel>
          <ListBox x:Name="SourceList" SelectionChanged="Source_SelectionChanged" BorderThickness="0" AutomationProperties.AutomationId="SourceList"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" Padding="18" CornerRadius="10">
        <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="保存配置并暂停" Click="Save_Click" Margin="0,12,0,0" AutomationProperties.AutomationId="SaveSource"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="本地直读配置" FontWeight="Bold" FontSize="17" Margin="0,0,0,12"/>
            <TextBlock Text="适配器" Margin="0,0,0,5"/>
            <ComboBox x:Name="AdapterBox" SelectedIndex="0" Padding="8" AutomationProperties.AutomationId="SourceAdapter">
              <ComboBoxItem Content="WxLocal（微信直读）" Tag="wxlocal"/>
              <ComboBoxItem Content="QqLocal（QQ直读）" Tag="qqlocal"/>
            </ComboBox>
            <TextBlock Text="本地账号别名（不填真实账号）" Margin="0,14,0,5"/>
            <TextBox x:Name="AliasBox" MaxLength="128" AutomationProperties.AutomationId="SourceAlias"/>
            <TextBlock Text="兜底轮询间隔（60～300 秒）" Margin="0,14,0,5"/>
            <TextBox x:Name="PollBox" Text="60"/>
            <TextBlock Text="首次回溯天数（1～30 天）" Margin="0,14,0,5"/>
            <TextBox x:Name="DaysBox" Text="7"/>
            <CheckBox x:Name="PushBox" Margin="0,14,0,0" AutomationProperties.AutomationId="SourcePushConsent">
              <TextBlock Text="启用实时文件监听（推荐）" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="保存后点击「读取会话」来查找本机账号。实时文件监听会在数据库有变化时触发同步。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="4" Background="White" Padding="18" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="授权会话" FontWeight="Bold" FontSize="17" Margin="0,0,0,14"/>
          <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="检查连接" Click="Health_Click" AutomationProperties.AutomationId="CheckSourceHealth"/>
            <Button Content="读取会话" Click="List_Click" Margin="0" AutomationProperties.AutomationId="DiscoverConversations"/>
          </WrapPanel>
          <DataGrid Grid.Row="2" x:Name="ConversationGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                    BorderThickness="0" Background="White" AutomationProperties.AutomationId="SourceConversations">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
              <DataGridTextColumn Header="会话名称" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
              <DataGridTextColumn Header="类型" Binding="{Binding DisplayType}" IsReadOnly="True" Width="50"/>
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="3" Content="保存会话选择并暂停" Click="Select_Click" Margin="0,12,0,12" AutomationProperties.AutomationId="SaveConversations"/>
          <WrapPanel Grid.Row="4">
            <Button Content="同步一次" Click="Once_Click" AutomationProperties.AutomationId="SyncOnce"/>
            <Button Content="开始后台同步" Click="Start_Click" AutomationProperties.AutomationId="StartSource"/>
            <Button Content="暂停" Click="Stop_Click" Margin="0" AutomationProperties.AutomationId="StopSource"/>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="HealthLabel" Text="最近成功同步：尚无记录" Foreground="#64748B" TextWrapping="Wrap"/>
      <TextBlock x:Name="StatusLabel" Text="保存配置不会发出网络请求；首次读取会话后默认全部不选。" Foreground="#0F766E" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="SourceStatus"/>
    </StackPanel>
  </Grid>
</Window>
