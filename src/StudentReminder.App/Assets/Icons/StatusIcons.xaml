<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StudentReminder.App">
  <!-- Geometries and colors from the adjacent SVG masters, on the original 24-unit grid. -->
  <RectangleGeometry x:Key="IconCanvas" Rect="0,0,24,24" />
  <DrawingImage x:Key="SyncingIcon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconCanvas}" />
        <GeometryDrawing Geometry="M4.2 9a8.1 8.1 0 0 1 13.2-3.3L20 8M20 3.8V8h-4.3M19.8 15a8.1 8.1 0 0 1-13.2 3.3L4 16m0 4.2V16h4.3">
          <GeometryDrawing.Pen>
            <Pen Brush="#0C6E5A" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="PausedIcon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconCanvas}" />
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Pen>
            <Pen Brush="#52617A" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M9.5 8.6v6.8m5-6.8v6.8">
          <GeometryDrawing.Pen>
            <Pen Brush="#52617A" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="PendingReviewIcon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconCanvas}" />
        <GeometryDrawing Geometry="M5.5 3.5h13a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H11l-4.5 3v-3h-1a2 2 0 0 1-2-2v-11a2 2 0 0 1 2-2Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#394CBB" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M9 8.4h6M9 13h3">
          <GeometryDrawing.Pen>
            <Pen Brush="#394CBB" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="CompletedIcon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconCanvas}" />
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Pen>
            <Pen Brush="#0C6E5A" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="m8 12 2.7 2.7L16 9.4">
          <GeometryDrawing.Pen>
            <Pen Brush="#0C6E5A" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="ReminderIcon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconCanvas}" />
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Pen>
            <Pen Brush="#8A4F03" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M12 7.4v5l3.2 1.8">
          <GeometryDrawing.Pen>
            <Pen Brush="#8A4F03" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="FailureIcon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="{StaticResource IconCanvas}" />
        <GeometryDrawing Geometry="M10.4 4.1a1.85 1.85 0 0 1 3.2 0L21 17.3a1.8 1.8 0 0 1-1.6 2.7H4.6A1.8 1.8 0 0 1 3 17.3Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#AA3448" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M12 9v4.4m0 3.1v.1">
          <GeometryDrawing.Pen>
            <Pen Brush="#AA3448" Thickness="2.25" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <Style x:Key="StatusIcon" TargetType="Image">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static local:StatusGlyph.Syncing}">
        <Setter Property="Source" Value="{StaticResource SyncingIcon}" />
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static local:StatusGlyph.Paused}">
        <Setter Property="Source" Value="{StaticResource PausedIcon}" />
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static local:StatusGlyph.PendingReview}">
        <Setter Property="Source" Value="{StaticResource PendingReviewIcon}" />
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static local:StatusGlyph.Completed}">
        <Setter Property="Source" Value="{StaticResource CompletedIcon}" />
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static local:StatusGlyph.Reminder}">
        <Setter Property="Source" Value="{StaticResource ReminderIcon}" />
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Tag" Value="{x:Static local:StatusGlyph.Failure}">
        <Setter Property="Source" Value="{StaticResource FailureIcon}" />
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
