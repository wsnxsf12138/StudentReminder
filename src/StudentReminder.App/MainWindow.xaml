<Window x:Class="StudentReminder.App.MainWindow"
        Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StudentReminder.App"
        Title="AI 学生事务助理" Width="1240" Height="850"
        MinWidth="1080" MinHeight="760" Background="#F7F9F8"
        FontFamily="Microsoft YaHei UI" FontSize="14"
        Closed="Window_Closed">
  <Grid Margin="22,16,22,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,10">
      <TextBlock Text="学生事务助理" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
        <Button x:Name="TodayButton" Style="{StaticResource NavigationIconButton}" Tag="{StaticResource IconToday}" Content="今日" Click="Today_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenToday"/>
        <Button x:Name="MoectButton" Style="{StaticResource NavigationIconButton}" Tag="{StaticResource IconImport}" Content="Moect 备用导入" Click="Moect_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenMoectWatch"/>
        <Button x:Name="SourcesButton" Style="{StaticResource NavigationIconButton}" Tag="{StaticResource IconSources}" Content="消息来源" Click="Sources_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenSources"/>
        <Button x:Name="AiButton" Style="{StaticResource NavigationIconButton}" Tag="{StaticResource IconSparkles}" Content="AI 分析" Click="Ai_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenAiAnalysis"/>
        <Button x:Name="ReviewButton" Style="{StaticResource NavigationIconButton}" Tag="{StaticResource IconTasks}" Content="事项" Click="Review_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenEventReview"/>
        <Button x:Name="SettingsButton" Style="{StaticResource NavigationIconButton}" Tag="{StaticResource IconSliders}" Content="设置" Click="Settings_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenReminderSettings"/>
      </StackPanel>
    </Grid>
    <TabControl Grid.Row="1" x:Name="HomeTabs" SelectionChanged="HomeTabs_SelectionChanged"
                Style="{StaticResource NavigationTabs}">
      <TabItem Header="事项日历" Tag="{StaticResource IconCalendar}" x:Name="CalendarTab" IsSelected="True">
        <local:ReminderCalendarView x:Name="CalendarView" />
      </TabItem>
      <TabItem Header="消息导入" Tag="{StaticResource IconImport}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="从合成样本开始" FontWeight="Bold" FontSize="16" />
          <TextBlock Text="128 条消息 · 16 类场景 · 可重复导入，验证本地存储与去重" Foreground="#64748B" Margin="0,5,0,0" />
        </StackPanel>
        <Button x:Name="SampleButton" Grid.Column="1" Content="导入合成样本" Click="Sample_Click" VerticalAlignment="Center" Margin="14,0,0,0" AutomationProperties.AutomationId="ImportSamples" />
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" BorderBrush="#DEE6ED" BorderThickness="1" Padding="20">
        <Grid x:Name="ImportPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="手动粘贴" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="一次粘贴保存为一条消息，保留原始换行。" FontSize="12" Foreground="#64748B" Margin="0,6,0,16" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="会话名称" Margin="0,0,0,6" />
          <TextBox x:Name="ConversationBox" Grid.Row="2" Text="手动收件箱" MaxLength="512" AutomationProperties.AutomationId="ConversationName" />
          <TextBlock Grid.Row="3" Text="消息发送时间（含时区）" Margin="0,14,0,6" />
          <TextBox x:Name="SentAtBox" Grid.Row="4" FontSize="12" AutomationProperties.AutomationId="MessageTime" />
          <TextBox x:Name="MessageBox" Grid.Row="5" Margin="0,14,0,14" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" MinHeight="105" MaxLength="65536" AutomationProperties.AutomationId="MessageText" />
          <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button Content="保存粘贴内容" Background="#0F766E" Foreground="White" Click="Paste_Click" AutomationProperties.AutomationId="ImportText" />
            <Button Content="导入 JSON" Click="Json_Click" Margin="0" AutomationProperties.AutomationId="ImportJson" />
          </StackPanel>
          <TextBlock Grid.Row="7" Text="消息先保存在本机。你可在「AI 分析」预览并选择要提交的内容。" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,16,0,0" />
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#DEE6ED" BorderThickness="1" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="155"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="已保存的消息" FontSize="18" FontWeight="Bold" />
              <TextBlock x:Name="CountLabel" Text="正在打开本地数据库…" Foreground="#64748B" FontSize="12" Margin="0,5,0,0" AutomationProperties.AutomationId="MessageCount" />
            </StackPanel>
            <Button x:Name="RefreshButton" Content="刷新" HorizontalAlignment="Right" Click="Refresh_Click" Margin="0" AutomationProperties.AutomationId="RefreshMessages" />
          </Grid>
          <DataGrid x:Name="MessagesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    SelectionChanged="Message_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#EDF1F5" BorderThickness="0" Background="White" RowHeight="39"
                    CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.AutomationId="MessagesList">
            <DataGrid.Columns>
              <DataGridTextColumn Header="会话" Binding="{Binding Conversation}" Width="125" />
              <DataGridTextColumn Header="消息" Binding="{Binding Text}" Width="*" MinWidth="100" />
              <DataGridTextColumn Header="状态" Binding="{Binding DisplayStatus}" Width="75" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="来源证据" Foreground="#0F766E" FontWeight="Bold" FontSize="12" Margin="0,0,0,7" />
            <TextBox x:Name="EvidenceBox" IsReadOnly="True" Text="选择一条消息，查看内容、账号别名、来源编号和时间。"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="108" Background="#F7FAFC" BorderThickness="0" FontSize="12" AutomationProperties.AutomationId="EvidenceDetails" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock x:Name="StatusLabel" Text="就绪" TextWrapping="Wrap" Foreground="#0F766E" AutomationProperties.AutomationId="ImportStatus" />
      <TextBlock x:Name="StorageLabel" Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
