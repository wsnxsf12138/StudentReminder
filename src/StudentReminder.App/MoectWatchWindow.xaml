<Window x:Class="StudentReminder.App.MoectWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moect 备用导入 · 学生事务助理" Width="790" Height="690" MinWidth="650" MinHeight="530"
        FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F3F6FA"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,15">
      <TextBlock Text="Moect 备用导入" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="选择已获授权的单群导出。窗口开启时会定期检查 JSON。导入后可在「AI 分析 → 历史消息」选择内容手动分析。" Margin="0,6,0,0" Foreground="#475569" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#DEE6ED" BorderThickness="1" Padding="14" CornerRadius="10" Margin="0,0,0,12">
      <StackPanel>
        <StackPanel x:Name="SettingsPanel" IsEnabled="False">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseFolder_Click" Margin="8,0,0,0" Padding="9,3"/>
            <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="Moect 导出目录"/>
          </DockPanel>
          <DockPanel Margin="0,0,0,9">
            <Button DockPanel.Dock="Right" Content="选择授权群样本" Click="ChooseGroup_Click" Margin="8,0,0,0" Padding="9,3"/>
            <TextBlock x:Name="GroupLabel" Text="尚未选择授权群" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <WrapPanel Margin="0,0,0,9">
            <TextBlock Text="检查间隔（分钟）" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="MinutesBox" Text="30" Width="64" AutomationProperties.Name="检查间隔（分钟）"/>
            <TextBlock Text="账号别名" VerticalAlignment="Center" Margin="18,0,8,0"/>
            <TextBox x:Name="AliasBox" Width="125" AutomationProperties.Name="账号别名"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="StartButton" Content="开始定时导入" Click="Start_Click" IsEnabled="False" Padding="10,4"/>
          <Button x:Name="RunButton" Content="立即检查" Click="Run_Click" IsEnabled="False" Margin="8,0" Padding="10,4"/>
          <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" IsEnabled="False" Padding="10,4"/>
        </StackPanel>
        <TextBlock x:Name="StatusLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#334155" AutomationProperties.AutomationId="MoectWatchStatus"/>
        <TextBlock x:Name="NextLabel" Margin="0,4,0,0" Foreground="#475569"/>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="2">
      <TextBlock DockPanel.Dock="Top" Text="旧版 Moect 分析结果" FontWeight="Bold" Margin="0,0,0,7"/>
      <DataGrid x:Name="ResultsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="White">
        <DataGrid.Columns>
          <DataGridTextColumn Header="消息时间" Binding="{Binding SentAt, StringFormat=yyyy-MM-dd HH:mm}" Width="145"/>
          <DataGridTextColumn Header="类型" Binding="{Binding Result.DisplayCategory}" Width="65"/>
          <DataGridTextColumn Header="事项" Binding="{Binding Result.Title}" Width="*"/>
          <DataGridTextColumn Header="原文中的时间" Binding="{Binding Result.TimeText}" Width="165"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </Grid>
</Window>
