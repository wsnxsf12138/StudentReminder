<UserControl x:Class="StudentReminder.App.ReminderCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="CalendarMuted" Color="#536779" />
    <SolidColorBrush x:Key="StartBackground" Color="#E0EDE8" />
    <SolidColorBrush x:Key="StartForeground" Color="#235C50" />
    <SolidColorBrush x:Key="DeadlineBackground" Color="#DDEAF9" />
    <SolidColorBrush x:Key="DeadlineForeground" Color="#255B90" />
    <Style x:Key="Weekday" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource CalendarMuted}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="CalendarNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Margin" Value="5,0,0,0" />
    </Style>
    <Style x:Key="EntryBadge" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource StartBackground}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="5,1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDeadline}" Value="True">
          <Setter Property="Background" Value="{StaticResource DeadlineBackground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
          <Setter Property="Background" Value="#E7EBEF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EntryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource StartForeground}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDeadline}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource DeadlineForeground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource CalendarMuted}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CalendarDayItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tile" Background="#F4F7F9" BorderBrush="Transparent" BorderThickness="2"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                <Setter TargetName="Tile" Property="Background" Value="#FAFBFC" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#EAF3F3" />
              </Trigger>
              <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="#84B3AD" />
              </DataTrigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#EDF7F5" />
                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Tile" Property="Visibility" Value="Hidden" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Date}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="286" />
    </Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="14" Padding="16,13,16,11">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="3,0,3,7">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="MonthTitle" FontSize="25" FontWeight="Bold" AutomationProperties.AutomationId="CalendarMonth" />
            <TextBlock x:Name="MonthSummary" Text="正在读取本地事项…" Foreground="{StaticResource CalendarMuted}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="回到今天" Style="{StaticResource CalendarNav}" Click="Today_Click" />
            <Button x:Name="PreviousMonth" Content="‹" FontSize="17" Style="{StaticResource CalendarNav}"
                    AutomationProperties.Name="上个月" Click="PreviousMonth_Click" />
            <Button x:Name="NextMonth" Content="›" FontSize="17" Style="{StaticResource CalendarNav}"
                    AutomationProperties.Name="下个月" Click="NextMonth_Click" />
          </StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,2">
          <TextBlock Text="一" Style="{StaticResource Weekday}" />
          <TextBlock Text="二" Style="{StaticResource Weekday}" />
          <TextBlock Text="三" Style="{StaticResource Weekday}" />
          <TextBlock Text="四" Style="{StaticResource Weekday}" />
          <TextBlock Text="五" Style="{StaticResource Weekday}" />
          <TextBlock Text="六" Style="{StaticResource Weekday}" />
          <TextBlock Text="日" Style="{StaticResource Weekday}" />
        </UniformGrid>
        <ListBox x:Name="Days" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource CalendarDayItem}" SelectionChanged="Days_SelectionChanged"
                 PreviewKeyDown="Days_PreviewKeyDown"
                 AutomationProperties.Name="事项月历">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="6" Columns="7" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel ClipToBounds="True">
                <Grid Margin="0,0,0,1">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                            <Setter Property="Foreground" Value="#798696" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Ellipse x:Name="TodayDot" Width="5" Height="5" Fill="{StaticResource Accent}"
                           VerticalAlignment="Top" Margin="4,2,0,0" Visibility="Collapsed" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding More}" FontSize="10" Foreground="{StaticResource CalendarMuted}"
                             VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Preview}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource EntryBadge}" Margin="0,0,0,1" ToolTip="{Binding Title}">
                        <TextBlock Text="{Binding Preview}" Style="{StaticResource EntryText}" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                  <Setter TargetName="TodayDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,6,0,0">
          <Ellipse Width="9" Height="9" Fill="#8AB8A9" VerticalAlignment="Center" />
          <TextBlock Text="开始" Foreground="{StaticResource CalendarMuted}" FontSize="12" Margin="5,0,16,0" />
          <Ellipse Width="9" Height="9" Fill="#8CADDA" VerticalAlignment="Center" />
          <TextBlock Text="截止" Foreground="{StaticResource CalendarMuted}" FontSize="12" Margin="5,0,16,0" />
          <Ellipse Width="9" Height="9" Fill="#AEB9C5" VerticalAlignment="Center" />
          <TextBlock Text="已完成" Foreground="{StaticResource CalendarMuted}" FontSize="12" Margin="5,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Column="2" Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="14" Padding="16,15">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock x:Name="DayTitle" FontSize="18" FontWeight="Bold" AutomationProperties.AutomationId="CalendarSelectedDate" />
          <TextBlock x:Name="DaySummary" Foreground="{StaticResource CalendarMuted}" FontSize="12" Margin="0,4,0,0" />
          <TextBlock x:Name="LoadError" Text="读取事项失败，切回首页后会重试。" TextWrapping="Wrap"
                     Foreground="#A23B27" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="EmptyDay" Grid.Row="1" Foreground="{StaticResource CalendarMuted}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="Agenda" AutomationProperties.AutomationId="CalendarAgenda">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#F6F8FA" CornerRadius="9" Padding="10" Margin="0,0,2,8">
                  <StackPanel>
                    <WrapPanel Margin="0,0,0,4">
                      <Border Style="{StaticResource EntryBadge}" Margin="0,0,6,0">
                        <TextBlock Text="{Binding When}" Style="{StaticResource EntryText}" />
                      </Border>
                      <TextBlock Text="{Binding Category}" Foreground="{StaticResource CalendarMuted}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="已完成" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </WrapPanel>
                    <Button Click="AgendaItem_Click" AutomationProperties.Name="{Binding Title}" ToolTip="打开事项详情">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="Margin" Value="0" />
                          <Setter Property="Padding" Value="0,2" />
                          <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                      </Button.Style>
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    </Button>
                    <TextBlock Text="{Binding Action}" Foreground="{StaticResource CalendarMuted}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Location}" Foreground="{StaticResource CalendarMuted}" FontSize="12" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Margin" Value="0,3,0,0" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Location}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Location}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
