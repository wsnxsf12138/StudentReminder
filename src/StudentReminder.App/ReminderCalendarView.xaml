<UserControl x:Class="StudentReminder.App.ReminderCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="CalendarInk" Color="#202B32" />
    <SolidColorBrush x:Key="CalendarMuted" Color="#53646C" />
    <SolidColorBrush x:Key="StartTile" Color="#E4EEE9" />
    <SolidColorBrush x:Key="StartBackground" Color="#CCDED5" />
    <SolidColorBrush x:Key="StartForeground" Color="#22624C" />
    <SolidColorBrush x:Key="DeadlineTile" Color="#E1EBF5" />
    <SolidColorBrush x:Key="DeadlineBackground" Color="#CCDFF0" />
    <SolidColorBrush x:Key="DeadlineForeground" Color="#245D8C" />
    <SolidColorBrush x:Key="CompletedTile" Color="#F0ECE3" />
    <SolidColorBrush x:Key="CompletedBackground" Color="#E6DDCE" />
    <SolidColorBrush x:Key="CompletedForeground" Color="#645441" />
    <Style x:Key="Weekday" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource CalendarMuted}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="CalendarNav" TargetType="Button" BasedOn="{StaticResource NavigationButton}">
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="EntryBadge" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource StartBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDeadline}" Value="True">
          <Setter Property="Background" Value="{StaticResource DeadlineBackground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
          <Setter Property="Background" Value="{StaticResource CompletedBackground}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EntryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource StartForeground}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDeadline}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource DeadlineForeground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource CompletedForeground}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CalendarDayItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="3" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
      <Setter Property="Cursor" Value="Hand" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Day_MouseDown" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Tile" Background="#F6F7F7" CornerRadius="14" />
              <ContentPresenter x:Name="DayContent"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Border x:Name="Outline" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Preview.IsDeadline}" Value="False">
                <Setter TargetName="Tile" Property="Background" Value="{StaticResource StartTile}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Preview.IsDeadline}" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{StaticResource DeadlineTile}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Preview.IsCompleted}" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{StaticResource CompletedTile}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                <Setter TargetName="Tile" Property="Opacity" Value="0.48" />
                <Setter TargetName="DayContent" Property="Opacity" Value="0.63" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="Outline" Property="BorderBrush" Value="#8CABA1" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outline" Property="BorderBrush" Value="#A5B7B3" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Outline" Property="BorderBrush" Value="#287A70" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Date}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False" />
          <Setter Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="3" CornerRadius="14" Margin="0,0,0,12" Padding="20,10">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Offset="0" Color="#F6EEE1" />
          <GradientStop Offset="1" Color="#F8F5ED" />
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <TextBlock x:Name="GreetingDate" DockPanel.Dock="Right" Foreground="#6D6051" FontSize="13"
                   FontWeight="Normal" VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock x:Name="Greeting" Foreground="#41382E" FontSize="18" FontWeight="SemiBold"
                   VerticalAlignment="Center" AutomationProperties.AutomationId="CalendarGreeting" />
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="White" BorderBrush="#EBEFED" BorderThickness="1" CornerRadius="16" Padding="16,13,16,11">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="3,0,3,8">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="MonthTitle" FontSize="25" FontWeight="Bold" Foreground="{StaticResource CalendarInk}"
                       AutomationProperties.AutomationId="CalendarMonth" />
            <TextBlock x:Name="MonthSummary" Text="正在读取本地事项…" Foreground="{StaticResource CalendarMuted}"
                       FontSize="13" FontWeight="Normal" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="今天" Style="{StaticResource CalendarNav}" Click="Today_Click"
                    AutomationProperties.Name="回到今天" />
            <Button x:Name="PreviousMonth" Style="{StaticResource CalendarNav}"
                    AutomationProperties.Name="上个月" Click="PreviousMonth_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconPrevious}" Style="{StaticResource NavigationIcon}"
                        Stroke="{Binding Foreground, ElementName=PreviousMonth}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="NextMonth" Style="{StaticResource CalendarNav}"
                    AutomationProperties.Name="下个月" Click="NextMonth_Click">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource IconNext}" Style="{StaticResource NavigationIcon}"
                        Stroke="{Binding Foreground, ElementName=NextMonth}" />
                </Canvas>
              </Viewbox>
            </Button>
          </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,5">
          <TextBlock Text="一" Style="{StaticResource Weekday}" />
          <TextBlock Text="二" Style="{StaticResource Weekday}" />
          <TextBlock Text="三" Style="{StaticResource Weekday}" />
          <TextBlock Text="四" Style="{StaticResource Weekday}" />
          <TextBlock Text="五" Style="{StaticResource Weekday}" />
          <TextBlock Text="六" Style="{StaticResource Weekday}" />
          <TextBlock Text="日" Style="{StaticResource Weekday}" />
        </UniformGrid>

        <ListBox x:Name="Days" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource CalendarDayItem}" SelectionChanged="Days_SelectionChanged"
                 PreviewKeyDown="Days_PreviewKeyDown" AutomationProperties.Name="事项月历">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="23" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DayNumber" Grid.Row="1" Text="{Binding Number}" FontSize="18"
                           FontWeight="Normal"
                           Foreground="{StaticResource CalendarInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="PreviewBadge" Grid.Row="2" DataContext="{Binding Preview}" Style="{StaticResource EntryBadge}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" ToolTip="{Binding Title}">
                  <DockPanel>
                    <TextBlock x:Name="MoreCount" DockPanel.Dock="Right" Margin="4,0,0,0"
                               Text="{Binding DataContext.More, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                               Style="{StaticResource EntryText}" />
                    <TextBlock Text="{Binding Preview}" Style="{StaticResource EntryText}"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                  <Setter TargetName="PreviewBadge" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding More}" Value="">
                  <Setter TargetName="MoreCount" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                  <Setter TargetName="DayNumber" Property="FontWeight" Value="SemiBold" />
                  <Setter TargetName="DayNumber" Property="Foreground" Value="#22675C" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="3,8,3,0">
          <TextBlock x:Name="LoadError" DockPanel.Dock="Right" Text="读取事项失败，切回首页后会重试。"
                     Foreground="#A23B27" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="14" Height="14" RadiusX="5" RadiusY="5" Fill="{StaticResource StartBackground}" VerticalAlignment="Center" />
            <TextBlock Text="开始" Foreground="{StaticResource CalendarMuted}" Margin="6,0,17,0" />
            <Rectangle Width="14" Height="14" RadiusX="5" RadiusY="5" Fill="{StaticResource DeadlineBackground}" VerticalAlignment="Center" />
            <TextBlock Text="截止" Foreground="{StaticResource CalendarMuted}" Margin="6,0,17,0" />
            <Rectangle Width="14" Height="14" RadiusX="5" RadiusY="5" Fill="{StaticResource CompletedBackground}" VerticalAlignment="Center" />
            <TextBlock Text="已完成" Foreground="{StaticResource CalendarMuted}" Margin="6,0,0,0" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#EBEFED" BorderThickness="1"
            CornerRadius="16" Padding="16,15">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="当天安排" Foreground="{StaticResource StartForeground}" FontSize="13" FontWeight="Normal" />
          <TextBlock x:Name="DayTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CalendarInk}"
                     Margin="0,5,0,0" AutomationProperties.AutomationId="CalendarSelectedDate" />
          <TextBlock x:Name="DaySummary" Foreground="{StaticResource CalendarMuted}" FontSize="12" FontWeight="Normal" Margin="0,4,0,0" />
        </StackPanel>
        <Border x:Name="EmptyState" Grid.Row="1" Background="#F6F8F7" CornerRadius="10" Padding="12"
                VerticalAlignment="Top" IsHitTestVisible="False">
          <TextBlock x:Name="EmptyDay" Foreground="{StaticResource CalendarMuted}" FontWeight="Normal" TextWrapping="Wrap" />
        </Border>
        <ScrollViewer x:Name="AgendaScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="True" AutomationProperties.Name="当天安排">
          <ItemsControl x:Name="Agenda" AutomationProperties.AutomationId="CalendarAgenda">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#F6F8FA" CornerRadius="9" Padding="10" Margin="0,0,2,8">
                  <StackPanel>
                    <WrapPanel Margin="0,0,0,4">
                      <Border Style="{StaticResource EntryBadge}" Margin="0,0,6,0">
                        <TextBlock Text="{Binding When}" Style="{StaticResource EntryText}" />
                      </Border>
                      <TextBlock Text="{Binding Category}" Foreground="{StaticResource CalendarMuted}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Text="已完成" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </WrapPanel>
                    <Button Click="AgendaItem_Click" AutomationProperties.Name="{Binding Title}" ToolTip="打开事项详情">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButton}">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="Margin" Value="0" />
                          <Setter Property="Padding" Value="0,2" />
                          <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                      </Button.Style>
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    </Button>
                    <TextBlock Text="{Binding Action}" Foreground="{StaticResource CalendarMuted}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Location}" Foreground="{StaticResource CalendarMuted}" FontSize="12" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Margin" Value="0,3,0,0" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Location}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Location}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
