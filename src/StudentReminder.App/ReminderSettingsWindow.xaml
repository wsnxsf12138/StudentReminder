<Window x:Class="StudentReminder.App.ReminderSettingsWindow"
        Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 学生事务助理" Width="560" Height="500" MinWidth="460" MinHeight="470"
        FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F3F6FA" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="提醒与摘要" FontSize="25" FontWeight="Bold" Margin="0,0,0,14" />
      <TextBlock Text="开始前提醒（分钟）" Margin="0,0,0,4" />
      <TextBox x:Name="StartRules" MaxLength="80" AutomationProperties.Name="开始前提醒分钟" />
      <TextBlock Text="截止前提醒（分钟）" Margin="0,12,0,4" />
      <TextBox x:Name="DeadlineRules" MaxLength="80" AutomationProperties.Name="截止前提醒分钟" />
      <TextBlock Text="用逗号分隔，例如 1440, 120。0 表示到点提醒，留空关闭该类提醒。"
                 TextWrapping="Wrap" Margin="0,7,0,0" />
      <TextBlock Text="每日摘要时间（本地 24 小时制）" Margin="0,12,0,4" />
      <TextBox x:Name="DigestTimeBox" MaxLength="5" AutomationProperties.Name="每日摘要时间" />
      <CheckBox x:Name="CloseToTray" Content="关闭主窗口时驻留托盘" Margin="0,14,0,7" />
      <CheckBox x:Name="StartupBox" Content="登录 Windows 后启动到托盘" Margin="0,0,0,12" />
      <WrapPanel>
        <Button x:Name="SaveButton" Content="保存设置" Click="Save_Click" />
        <Button Content="消息来源" Click="Sources_Click" />
        <Button Content="AI 分析" Click="Ai_Click" />
      </WrapPanel>
      <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap" />
      <Separator Margin="0,16,0,12" />
      <TextBlock Text="隐私与数据" FontSize="20" FontWeight="Bold" />
      <TextBlock x:Name="CachePaths" Margin="0,8,0,0" TextWrapping="Wrap" />
      <TextBlock x:Name="SyncFolderWarning" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#9A3412"
                 Visibility="Collapsed" Text="此数据目录位于识别到的同步盘路径。直读缓存含明文和密钥，请改用本机非同步目录。" />
      <Button x:Name="ClearCacheButton" HorizontalAlignment="Left" Margin="0,10,0,0"
              Content="清除微信和 QQ 直读缓存" Click="ClearCache_Click" />
      <TextBlock x:Name="CacheStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
