<Window x:Class="StudentReminder.App.TodayWindow"
        Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日 · 学生事务助理" Width="850" Height="690" MinWidth="640" MinHeight="460"
        FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F3F6FA" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <WrapPanel DockPanel.Dock="Right">
        <Button Content="刷新摘要" Click="Refresh_Click" x:Name="RefreshButton"/>
        <ComboBox x:Name="ProviderBox" Width="104" Margin="0,0,8,0" VerticalContentAlignment="Center"
                  AutomationProperties.Name="摘要润色服务商" SelectedIndex="0">
          <ComboBoxItem Content="DeepSeek" Tag="deepseek"/><ComboBoxItem Content="豆包" Tag="doubao"/>
        </ComboBox>
        <Button Content="AI 润色" Click="Polish_Click" x:Name="PolishButton"/>
        <Button Content="取消润色" Click="CancelPolish_Click" x:Name="CancelButton" IsEnabled="False"/>
      </WrapPanel>
      <StackPanel>
        <TextBlock Text="今日" FontSize="26" FontWeight="Bold"/>
        <TextBlock x:Name="GeneratedLabel" Margin="0,5,0,0"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="每日摘要">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Sections" Margin="12,6">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4,0,12">
                  <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,2">
                          <Button DockPanel.Dock="Right" Content="查看详情" Click="Open_Click" Tag="{Binding}"
                                  Visibility="{Binding LinkVisibility}" Padding="10,4" Margin="12,0,0,0"/>
                          <Image Style="{StaticResource StatusIcon}" Tag="{Binding Glyph}" DockPanel.Dock="Left" />
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="MissedTab" Header="错过的提醒">
        <DockPanel Margin="12">
          <TextBlock x:Name="MissedCaption" DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"/>
          <ListBox x:Name="Missed" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Content="查看事项" Click="Open_Click" Tag="{Binding}"
                          Padding="10,4" Margin="12,0,0,0"/>
                  <Image Style="{StaticResource StatusIcon}" Tag="{Binding Glyph}" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" x:Name="StatusLabel" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </Grid>
</Window>
